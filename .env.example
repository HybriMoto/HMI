# HybriMoto India - Environment Configuration Example
# All submissions route to official email: team@hybrimotoindia.com

# Target Receiving Email Address
VITE_RECEIVING_EMAIL=team@hybrimotoindia.com

# Client-Side Email Service API Access Keys (Select one for production deployment)
# Web3Forms Public Access Key (recommended for GitHub Pages static hosting):
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Formspree Endpoint URL (alternative static form handler):
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id_here
